{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSTR1InputSchema",
  "description": "Canonical input schema for GSTR-1 outward supplies data",
  "type": "object",
  "required": ["gstin", "fp", "invoices"],
  "properties": {
    "gstin": {
      "type": "string",
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$",
      "description": "15-digit GSTIN of the supplier"
    },
    "fp": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])20[2-9][0-9]$",
      "description": "Financial period in MMYYYY format (e.g. 042026 for April 2026)"
    },
    "gt": {
      "type": "number",
      "minimum": 0,
      "description": "Gross turnover in the preceding financial year"
    },
    "cur_gt": {
      "type": "number",
      "minimum": 0,
      "description": "Current financial year turnover up to the current period"
    },
    "invoices": {
      "type": "array",
      "description": "List of outward supply sales invoices",
      "items": {
        "type": "object",
        "required": ["inum", "idt", "pos", "items"],
        "properties": {
          "inum": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16,
            "description": "Invoice number (max 16 alphanumeric characters)"
          },
          "idt": {
            "type": "string",
            "pattern": "^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-20[2-9][0-9]$",
            "description": "Invoice date in DD-MM-YYYY format"
          },
          "val": {
            "type": "number",
            "minimum": 0,
            "description": "Total invoice value including taxes"
          },
          "pos": {
            "type": "string",
            "pattern": "^(0[1-9]|[1-3][0-9]|97)$",
            "description": "2-digit Place of Supply state code"
          },
          "rchrg": {
            "type": "string",
            "enum": ["Y", "N"],
            "default": "N",
            "description": "Reverse charge applicable"
          },
          "inv_typ": {
            "type": "string",
            "enum": ["R", "DE", "SEZWP", "SEZWOP", "CBW"],
            "default": "R",
            "description": "Invoice type: Regular, Deemed Export, SEZ with payment, SEZ without payment, Custom Bonded Warehouse"
          },
          "ctin": {
            "type": "string",
            "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$",
            "description": "Recipient GSTIN for B2B supplies (omitted for B2C)"
          },
          "etin": {
            "type": "string",
            "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$",
            "description": "E-commerce Operator GSTIN if supply through ECO"
          },
          "exp_typ": {
            "type": "string",
            "enum": ["WPAY", "WOPAY"],
            "description": "Export type: with payment or without payment"
          },
          "sb_num": { "type": "string", "description": "Shipping bill number" },
          "sb_dt": { "type": "string", "description": "Shipping bill date" },
          "port_code": { "type": "string", "description": "Port code for export" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["txval", "rt"],
              "properties": {
                "txval": { "type": "number", "minimum": 0, "description": "Taxable value" },
                "rt": { "type": "number", "enum": [0, 0.1, 0.25, 1.5, 3, 5, 6, 12, 18, 28], "description": "GST Rate percentage" },
                "iamt": { "type": "number", "minimum": 0, "default": 0, "description": "Integrated Tax amount" },
                "camt": { "type": "number", "minimum": 0, "default": 0, "description": "Central Tax amount" },
                "samt": { "type": "number", "minimum": 0, "default": 0, "description": "State/UT Tax amount" },
                "csamt": { "type": "number", "minimum": 0, "default": 0, "description": "Cess amount" },
                "hsn_sc": { "type": "string", "description": "HSN/SAC Code (4, 6 or 8 digits)" },
                "desc": { "type": "string", "description": "Description of goods or services" },
                "uqc": { "type": "string", "description": "Unit Quantity Code e.g. NOS, KGS, MTR, PCS, OTH" },
                "qty": { "type": "number", "minimum": 0, "description": "Quantity supplied" }
              }
            }
          }
        }
      }
    },
    "credit_debit_notes": {
      "type": "array",
      "description": "List of credit and debit notes issued",
      "items": {
        "type": "object",
        "required": ["nt_num", "nt_dt", "ntty", "inum", "idt", "pos", "items"],
        "properties": {
          "nt_num": { "type": "string", "description": "Note number" },
          "nt_dt": { "type": "string", "pattern": "^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-20[2-9][0-9]$" },
          "ntty": { "type": "string", "enum": ["C", "D"], "description": "C for Credit Note, D for Debit Note" },
          "inum": { "type": "string", "description": "Original invoice number" },
          "idt": { "type": "string", "description": "Original invoice date" },
          "val": { "type": "number", "minimum": 0 },
          "pos": { "type": "string" },
          "rchrg": { "type": "string", "enum": ["Y", "N"], "default": "N" },
          "ctin": { "type": "string", "description": "Recipient GSTIN (if registered CDNR)" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["txval", "rt"],
              "properties": {
                "txval": { "type": "number" },
                "rt": { "type": "number" },
                "iamt": { "type": "number", "default": 0 },
                "camt": { "type": "number", "default": 0 },
                "samt": { "type": "number", "default": 0 },
                "csamt": { "type": "number", "default": 0 }
              }
            }
          }
        }
      }
    },
    "nil_exempt_non_gst": {
      "type": "object",
      "properties": {
        "nil_inter_reg": { "type": "number", "default": 0 },
        "nil_inter_unreg": { "type": "number", "default": 0 },
        "nil_intra_reg": { "type": "number", "default": 0 },
        "nil_intra_unreg": { "type": "number", "default": 0 },
        "expt_inter_reg": { "type": "number", "default": 0 },
        "expt_inter_unreg": { "type": "number", "default": 0 },
        "expt_intra_reg": { "type": "number", "default": 0 },
        "expt_intra_unreg": { "type": "number", "default": 0 },
        "ngsup_inter_reg": { "type": "number", "default": 0 },
        "ngsup_inter_unreg": { "type": "number", "default": 0 },
        "ngsup_intra_reg": { "type": "number", "default": 0 },
        "ngsup_intra_unreg": { "type": "number", "default": 0 }
      }
    },
    "advances_received": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pos", "rt", "ad_amt"],
        "properties": {
          "pos": { "type": "string" },
          "rt": { "type": "number" },
          "ad_amt": { "type": "number" },
          "iamt": { "type": "number", "default": 0 },
          "camt": { "type": "number", "default": 0 },
          "samt": { "type": "number", "default": 0 },
          "csamt": { "type": "number", "default": 0 }
        }
      }
    },
    "advances_adjusted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pos", "rt", "adj_amt"],
        "properties": {
          "pos": { "type": "string" },
          "rt": { "type": "number" },
          "adj_amt": { "type": "number" },
          "iamt": { "type": "number", "default": 0 },
          "camt": { "type": "number", "default": 0 },
          "samt": { "type": "number", "default": 0 },
          "csamt": { "type": "number", "default": 0 }
        }
      }
    },
    "doc_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_num", "from", "to", "totnum", "canc", "net_issue"],
        "properties": {
          "doc_num": { "type": "integer", "description": "1: Invoices, 2: Inward RCM, 3: Revised, 4: Debit, 5: Credit, 6: Receipt, 7: Payment, 8: Refund, 9: Delivery Challan Job Work, 10: Supply on Approval, 11: Semi-knocked down, 12: Other Delivery Challans" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "totnum": { "type": "integer" },
          "canc": { "type": "integer" },
          "net_issue": { "type": "integer" }
        }
      }
    }
  }
}
