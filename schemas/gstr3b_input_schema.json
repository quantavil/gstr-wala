{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSTR3BInputSchema",
  "description": "Canonical input schema for GSTR-3B summary return data, ITC inputs, and ledger balances",
  "type": "object",
  "required": ["gstin", "ret_period"],
  "properties": {
    "gstin": {
      "type": "string",
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
    },
    "ret_period": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])20[2-9][0-9]$"
    },
    "due_date": {
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-20[2-9][0-9]$"
    },
    "filing_date": {
      "type": "string",
      "pattern": "^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-20[2-9][0-9]$"
    },
    "turnover_slab": {
      "type": "string",
      "enum": ["upto_1.5cr", "1.5cr_to_5cr", "above_5cr"],
      "default": "upto_1.5cr",
      "description": "Annual turnover slab for late fee cap calculation"
    },
    "outward_supplies": {
      "type": "object",
      "properties": {
        "taxable": {
          "type": "object",
          "properties": {
            "txval": { "type": "number", "default": 0 },
            "iamt": { "type": "number", "default": 0 },
            "camt": { "type": "number", "default": 0 },
            "samt": { "type": "number", "default": 0 },
            "csamt": { "type": "number", "default": 0 }
          }
        },
        "zero_rated": {
          "type": "object",
          "properties": {
            "txval": { "type": "number", "default": 0 },
            "iamt": { "type": "number", "default": 0 },
            "csamt": { "type": "number", "default": 0 }
          }
        },
        "nil_exempt": {
          "type": "object",
          "properties": {
            "txval": { "type": "number", "default": 0 }
          }
        },
        "rcm_inward": {
          "type": "object",
          "description": "Inward supplies liable to reverse charge (Table 3.1(d))",
          "properties": {
            "txval": { "type": "number", "default": 0 },
            "iamt": { "type": "number", "default": 0 },
            "camt": { "type": "number", "default": 0 },
            "samt": { "type": "number", "default": 0 },
            "csamt": { "type": "number", "default": 0 }
          }
        },
        "non_gst": {
          "type": "object",
          "properties": {
            "txval": { "type": "number", "default": 0 }
          }
        }
      }
    },
    "eco_supplies": {
      "type": "object",
      "description": "Supplies notified under Section 9(5) (Table 3.1.1)",
      "properties": {
        "eco_pays_tax": {
          "type": "object",
          "properties": {
            "txval": { "type": "number", "default": 0 },
            "iamt": { "type": "number", "default": 0 },
            "camt": { "type": "number", "default": 0 },
            "samt": { "type": "number", "default": 0 },
            "csamt": { "type": "number", "default": 0 }
          }
        },
        "registered_through_eco": {
          "type": "object",
          "properties": {
            "txval": { "type": "number", "default": 0 }
          }
        }
      }
    },
    "inter_state_supplies": {
      "type": "array",
      "description": "Table 3.2 details of inter-state supplies to unregistered, composition, and UIN holders",
      "items": {
        "type": "object",
        "required": ["pos", "supply_type", "txval", "iamt"],
        "properties": {
          "pos": { "type": "string" },
          "supply_type": { "type": "string", "enum": ["unregistered", "composition", "uin"] },
          "txval": { "type": "number" },
          "iamt": { "type": "number" }
        }
      }
    },
    "itc": {
      "type": "object",
      "description": "Table 4 Eligible and Ineligible ITC",
      "properties": {
        "available": {
          "type": "object",
          "properties": {
            "import_goods": { "type": "object", "properties": { "iamt": { "type": "number", "default": 0 }, "csamt": { "type": "number", "default": 0 } } },
            "import_services": { "type": "object", "properties": { "iamt": { "type": "number", "default": 0 }, "csamt": { "type": "number", "default": 0 } } },
            "rcm_inward": { "type": "object", "properties": { "iamt": { "type": "number", "default": 0 }, "camt": { "type": "number", "default": 0 }, "samt": { "type": "number", "default": 0 }, "csamt": { "type": "number", "default": 0 } } },
            "isd": { "type": "object", "properties": { "iamt": { "type": "number", "default": 0 }, "camt": { "type": "number", "default": 0 }, "samt": { "type": "number", "default": 0 }, "csamt": { "type": "number", "default": 0 } } },
            "all_other": { "type": "object", "properties": { "iamt": { "type": "number", "default": 0 }, "camt": { "type": "number", "default": 0 }, "samt": { "type": "number", "default": 0 }, "csamt": { "type": "number", "default": 0 } } }
          }
        },
        "reversed": {
          "type": "object",
          "properties": {
            "permanent_17_5_rules": {
              "type": "object",
              "description": "Rule 38, 42, 43 and Section 17(5) blocked credit reversals",
              "properties": { "iamt": { "type": "number", "default": 0 }, "camt": { "type": "number", "default": 0 }, "samt": { "type": "number", "default": 0 }, "csamt": { "type": "number", "default": 0 } }
            },
            "temporary_others": {
              "type": "object",
              "description": "Rule 37 (180 days non-payment), Rule 37A, and temporary reversals",
              "properties": { "iamt": { "type": "number", "default": 0 }, "camt": { "type": "number", "default": 0 }, "samt": { "type": "number", "default": 0 }, "csamt": { "type": "number", "default": 0 } }
            }
          }
        },
        "other_details": {
          "type": "object",
          "properties": {
            "reclaimed": {
              "type": "object",
              "description": "Table 4(D)(1) Reclaimed ITC previously reversed under 4(B)(2)",
              "properties": { "iamt": { "type": "number", "default": 0 }, "camt": { "type": "number", "default": 0 }, "samt": { "type": "number", "default": 0 }, "csamt": { "type": "number", "default": 0 } }
            },
            "ineligible_16_4_pos": {
              "type": "object",
              "description": "Table 4(D)(2) Ineligible ITC under section 16(4) & POS rules",
              "properties": { "iamt": { "type": "number", "default": 0 }, "camt": { "type": "number", "default": 0 }, "samt": { "type": "number", "default": 0 }, "csamt": { "type": "number", "default": 0 } }
            }
          }
        }
      }
    },
    "inward_exempt_nil_non_gst": {
      "type": "object",
      "properties": {
        "from_composition_exempt": {
          "type": "object",
          "properties": { "inter": { "type": "number", "default": 0 }, "intra": { "type": "number", "default": 0 } }
        },
        "non_gst": {
          "type": "object",
          "properties": { "inter": { "type": "number", "default": 0 }, "intra": { "type": "number", "default": 0 } }
        }
      }
    },
    "opening_credit_ledger": {
      "type": "object",
      "description": "Opening balance in Electronic Credit Ledger",
      "properties": {
        "iamt": { "type": "number", "default": 0 },
        "camt": { "type": "number", "default": 0 },
        "samt": { "type": "number", "default": 0 },
        "csamt": { "type": "number", "default": 0 }
      }
    },
    "opening_cash_ledger": {
      "type": "object",
      "description": "Opening balance in Electronic Cash Ledger",
      "properties": {
        "iamt": { "type": "number", "default": 0 },
        "camt": { "type": "number", "default": 0 },
        "samt": { "type": "number", "default": 0 },
        "csamt": { "type": "number", "default": 0 }
      }
    }
  }
}
