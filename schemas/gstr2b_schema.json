{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSTR2BSchema",
  "description": "GSTN Official GSTR-2B JSON Auto-Drafted Statement Schema",
  "type": "object",
  "required": ["gstin", "fp", "data"],
  "properties": {
    "gstin": { "type": "string" },
    "fp": { "type": "string" },
    "data": {
      "type": "object",
      "properties": {
        "docdata": {
          "type": "object",
          "properties": {
            "b2b": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ctin": { "type": "string" },
                  "trdnm": { "type": "string" },
                  "suppr_typ": { "type": "string" },
                  "inv": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "inum": { "type": "string" },
                        "typ": { "type": "string" },
                        "dt": { "type": "string" },
                        "val": { "type": "number" },
                        "pos": { "type": "string" },
                        "rev": { "type": "string" },
                        "itcavl": { "type": "string", "enum": ["Y", "N"] },
                        "rsn": { "type": "string" },
                        "diffprcnt": { "type": "number" },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "num": { "type": "integer" },
                              "txval": { "type": "number" },
                              "rt": { "type": "number" },
                              "iamt": { "type": "number" },
                              "camt": { "type": "number" },
                              "samt": { "type": "number" },
                              "csamt": { "type": "number" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "b2ba": { "type": "array" },
            "cdnr": { "type": "array" },
            "cdnra": { "type": "array" },
            "isd": { "type": "array" },
            "impg": { "type": "array" },
            "impgsez": { "type": "array" }
          }
        }
      }
    }
  }
}
